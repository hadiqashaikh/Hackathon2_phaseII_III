{
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "/my-todo/api/auth/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/main.py"
    },
    {
      "source": "/:path*",
      "destination": "/my-todo/:path*"
    }
  ],
  "functions": {
    "api/main.py": {
      "runtime": "python3.11"
    }
  },
  "env": {
    "PYTHONPATH": "."
  }
}
